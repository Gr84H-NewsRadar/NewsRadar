[MASTER]
# Añadir el directorio padre al path para que pylint resuelva los imports
# de 'app.*' igual que uvicorn cuando arranca desde /app
init-hook='import sys; sys.path.insert(0, ".")'
ignore=tests

[MESSAGES CONTROL]
disable=
    # E1102: func.now() de SQLAlchemy es callable; pylint no analiza
    # la metaclase de func correctamente (falso positivo conocido)
    E1102,
    # W0613: current_user en endpoints FastAPI es una dependencia de
    # autenticación inyectada por Depends(); no es un argumento "no usado"
    W0613,
    # R0917: Depends() de FastAPI cuenta como argumento posicional;
    # el límite estándar de 5 no aplica a endpoints con inyección de dependencias
    R0917

[FORMAT]
# 100 caracteres es muy estricto para URLs de RSS y cadenas SQL; 120 es
# el estándar de la mayoría de proyectos Python modernos (black, ruff)
max-line-length=120

[DESIGN]
# main.py concentra todos los endpoints por diseño (arquitectura monolítica
# deliberada para facilitar el despliegue); se refactorizaría en routers
# en una siguiente iteración
max-module-lines=1400
# email_service.send_cycle_summary construye un email HTML complejo;
# las variables locales son todas necesarias (subject, body, html, stats...)
max-locals=22
# Aumentar ligeramente el límite de argumentos para funciones de resumen
max-args=8
